# The environment file for deploy/compose.yml. Copy it to deploy/.env, fill in the seven values
# left empty, and keep that file to yourself: it is not committed. Compose refuses to start
# while one of the seven is empty. deploy/README.md says what each part of the stack does.
#
# The repo-root .env.example is for a local checkout, not for this stack.

# --- Required -----------------------------------------------------------------------------------

# The Postgres superuser. Only the postgres container has it.
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# The role that owns the schema and migrates it. Only tinyserver-init has it.
#   openssl rand -hex 24
APP_OWNER_PASSWORD=

# The role the server runs as. These two go into a database URL, so keep them to letters and
# digits, as the command makes them.
#   openssl rand -hex 24
APP_RUNTIME_PASSWORD=

# Signs media paths. 64 hex characters.
#   openssl rand -hex 32
TINYSERVER_MEDIA_HMAC_SECRET=

# The address people type into tinyclient, such as https://chat.example.org. A hostname, never
# an IP address, with no path and no trailing slash. Passkeys belong to this host: do not change
# it once anyone has one (docs/auth-passkeys.md).
TINYSERVER_PUBLIC_URL=

# Pocket ID's address and its issuer, such as https://auth.example.org. No path and no trailing
# slash. Keep it set after compose.passkey.yml retires Pocket ID too: compose still reads it.
AUTH_PUBLIC_URL=

# The token of the Cloudflare tunnel that carries both hostnames; Cloudflare shows it when you
# create the tunnel. With compose.proxy.yml and no tunnel, write TUNNEL_TOKEN=unused.
TUNNEL_TOKEN=

# --- Optional -----------------------------------------------------------------------------------
# Unset, each has the default deploy/compose.yml gives it. Uncomment to change one.

# Calls. Without TINYSERVER_PUBLIC_IP the server runs and calls have no media. It is the address
# members reach the media port at, and every member in a call sees it. See "Calls and the media
# port" in deploy/README.md.
#TINYSERVER_PUBLIC_IP=
#TINYSERVER_MEDIA_PORT=50000
# The host's address on the home network, for members on it.
#TINYSERVER_LAN_IP=
# What the host can upload for calls, in kb/s. Unset is no budget.
#TINYSERVER_MEDIA_EGRESS_KBPS=

# Days a sign-in lasts, 1 to 365.
#TINYSERVER_SESSION_MAX_DAYS=30

# Sign-in through Pocket ID. See "Other providers" in deploy/README.md.
#TINYSERVER_OIDC_PROVIDER_NAME=Pocket ID
# pocket-id lets an invite make the person's account; none turns that off.
#TINYSERVER_OIDC_SIGNUP=pocket-id
#TINYSERVER_OIDC_POCKETID_GROUP_IDS=
#TINYSERVER_OIDC_MEMBER_GROUPS=
#TINYSERVER_OIDC_ADMIN_GROUPS=
# The name on Pocket ID's pages.
#AUTH_APP_NAME=tinyserver

# With compose.passkey.yml: the name a browser shows when it asks for a passkey.
#TINYSERVER_PASSKEY_RP_NAME=TinyComms

# Whose client-address header the sign-in limiter believes, and which header. See "Without
# Cloudflare" in deploy/README.md.
#TINYSERVER_TRUSTED_PROXIES=
#TINYSERVER_CLIENT_IP_HEADER=

# clamd scans uploads. Leave this alone; deploy/scan-off.yml is how scanning is turned off.
#TINYSERVER_SCAN_ENGINE=clamd

# Where the data lives. Unset, Docker keeps named volumes; a path is a host directory.
#TINYSERVER_PG_DIR=
#POCKETID_DATA_DIR=
# The directory pocket-id/setup.sh writes the three sign-in secrets to.
#TINYSERVER_SECRETS_DIR=./secrets

# The internal network and the tunnel's fixed address on it. Change both if the range is taken.
#TINYSERVER_INSIDE_SUBNET=172.30.53.0/24
#TINYSERVER_TUNNEL_IP=172.30.53.10

# Caps, not reservations. Raise them for a large community.
#TINYSERVER_MEM_LIMIT=1g
#TINYSERVER_PIDS_LIMIT=512
#TINYSERVER_CPUS=2
#TINYSERVER_PG_MEM_LIMIT=1g
#TINYSERVER_PG_PIDS_LIMIT=256
#TINYSERVER_CLAMD_MEM_LIMIT=3g

# With compose.image.yml: the published image to run instead of building one.
#TINYSERVER_IMAGE=

# The database and role names. deploy/tenant/tenant.sh sets these for a tenant; a single
# community leaves them alone.
#TINYSERVER_DB_NAME=tinyserver
#TINYSERVER_OWNER_ROLE=app_owner
#TINYSERVER_RUNTIME_ROLE=app_runtime
#TINYSERVER_OWNER_CREATEDB=yes
