# Local development defaults. Copy to .env. These are not production secrets.
# Point DATABASE_URL at the Postgres that publishes port 54329.

POSTGRES_PASSWORD=postgres
APP_OWNER_PASSWORD=app_owner
APP_RUNTIME_PASSWORD=app_runtime

DATABASE_URL=postgres://app_runtime:app_runtime@127.0.0.1:54329/tinyserver?sslmode=disable
DATABASE_URL_MIGRATE=postgres://app_owner:app_owner@127.0.0.1:54329/tinyserver?sslmode=disable

BIND=127.0.0.1:8080

# Call audio. Without TINYSERVER_PUBLIC_IP the server runs and calls have no media.
TINYSERVER_PUBLIC_IP=127.0.0.1
TINYSERVER_MEDIA_PORT=50000

# Sign-in. `serve` needs an OpenID Connect provider with a confidential client whose redirect
# URI is ${TINYSERVER_PUBLIC_URL}/v1/auth/callback. The issuer is compared exactly, trailing
# slash and all. https only, except http to 127.0.0.1, localhost, or [::1].
TINYSERVER_PUBLIC_URL=http://127.0.0.1:8080
TINYSERVER_OIDC_ISSUER=https://auth.example.org
TINYSERVER_OIDC_CLIENT_ID=tinyserver
# Prefer the _FILE form. Set one, not both.
TINYSERVER_OIDC_CLIENT_SECRET_FILE=./secrets/oidc_client_secret
#TINYSERVER_OIDC_CLIENT_SECRET=
#TINYSERVER_OIDC_SCOPES=openid profile email
#TINYSERVER_OIDC_PROVIDER_NAME=Pocket ID
# Where this server reaches the provider when not at the issuer, such as http://pocket-id:1411.
#TINYSERVER_OIDC_INTERNAL_URL=
# Pocket ID only: someone with an invite and no account makes one, with a single-use sign-up
# link made through Pocket ID's API (an admin or static API key). The API is reached at
# TINYSERVER_OIDC_POCKETID_INTERNAL_URL, else the internal URL above, else the issuer.
#TINYSERVER_OIDC_SIGNUP=pocket-id
#TINYSERVER_OIDC_POCKETID_API_KEY_FILE=./secrets/pocketid_api_key
#TINYSERVER_OIDC_POCKETID_INTERNAL_URL=
#TINYSERVER_OIDC_POCKETID_GROUP_IDS=
# private_key_jwt instead of a secret: a PKCS#1 RSA key in PEM, and its kid if wanted.
#TINYSERVER_OIDC_PRIVATE_KEY_FILE=
#TINYSERVER_OIDC_PRIVATE_KEY_ID=
# Groups from the provider. Unset is invite only. Never owner.
#TINYSERVER_OIDC_GROUPS_CLAIM=groups
#TINYSERVER_OIDC_MEMBER_GROUPS=
#TINYSERVER_OIDC_ADMIN_GROUPS=
# Several providers: list ids, then TINYSERVER_OIDC_<ID>_ISSUER, _CLIENT_ID, _CLIENT_SECRET(_FILE),
# _NAME, and the rest as above. The first is the default.
#TINYSERVER_OIDC_PROVIDERS=pocket-id,google
#TINYSERVER_SESSION_MAX_DAYS=30
